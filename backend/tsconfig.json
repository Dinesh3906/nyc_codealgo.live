{
  "compilerOptions": {
    "target": "ES2020",          // JS version to compile to
    "module": "commonjs",        // Node.js module system
    "rootDir": "src",            // Your source folder
    "outDir": "dist",            // Where compiled JS goes
    "strict": true,              // Enable all strict type checks
    "esModuleInterop": true,     // Allow import/export interop
    "skipLibCheck": true,        // Skip type checking node_modules
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],        // Compile all TS files in src
  "exclude": ["node_modules", "dist"]
}